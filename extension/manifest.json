{
  "manifest_version": 3,
  "name": "Tollkit Wallet",
  "version": "0.1.0",
  "description": "Connect websites to the Tollkit Wallet on this computer. Keys stay in Tollkit, and you approve every request there.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Tollkit Wallet", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["https://*/*", "http://localhost/*"], "js": ["inpage.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://*/*", "http://localhost/*"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
